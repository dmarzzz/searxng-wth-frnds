# swf-node configuration. Every value here can be overridden by the
# OS environment; this file is just a reference. The daemon does NOT
# auto-load .env — point at it via your shell's mechanism (direnv,
# dotenvx, `set -a; source .env; set +a`, etc.).
#
# Most users don't need this file. Defaults are sensible and the
# daemon works zero-config.
#
# Full env-var reference: docs/CONFIG.md.

# ── Network ──────────────────────────────────────────────────────────
# SWF_BIND      = 127.0.0.1     # set to 0.0.0.0 to accept LAN peers
# SWF_PORT      = 7777
# SWF_NO_MDNS   = 0             # 1 to disable mDNS advertising
# SWF_FULL      = 0             # 1 = aggregator mode (requires [community-full] extras)

# ── State / paths ────────────────────────────────────────────────────
# SWF_CONFIG_DIR    = ~/.config/swf
# SWF_KNOWLEDGE_DIR = ~/world_knowledge
# SWF_STATE_DIR     = ~/.local/share/swf

# ── Privacy / sharing posture ────────────────────────────────────────
# Default share_scope for newly-indexed user-fetched pages. With
# 'friends' (the default), every page you fetch becomes shareable
# with peers you've added via `swf-peer add`. Use 'private' on a
# sensitive box.
# SWF_DEFAULT_SHARE_SCOPE = friends      # private | local_only | friends | public
# SWF_DISABLE_KNOWLEDGE_WRITE = 0        # 1 = don't write markdown to ~/world_knowledge/

# ── Auth (required when SWF_BIND is non-loopback) ────────────────────
# Bearer token for the privileged /web_search-family routes. Peer
# routes (Ed25519-signed responses) don't need this.
# SWF_AGENT_TOKEN =

# ── Optional integrations ────────────────────────────────────────────
# SearXNG (PUBLIC_FROM_SELF egress). When unset, the router walks
# LOCAL_CACHE → LOCAL_INDREX → LAN_FRIEND_DCNET (gated) and stops.
# SEARXNG_URL = http://127.0.0.1:8888

# Direct DDG fallback when SearXNG is unreachable. Privacy: still
# SELF_PUBLIC_EGRESS, just without SearXNG aggregation. Off by default.
# SWF_ALLOW_DIRECT_ENGINES = 0

# Tailscale: auto-detected via `tailscale status --json`. No env var
# needed; just have the binary on PATH.

# ── Logging ──────────────────────────────────────────────────────────
# SWF_LOG_LEVEL = INFO          # DEBUG | INFO | WARNING | ERROR

# ── Feature flags (rarely touched) ───────────────────────────────────
# SWF_ENABLE_TICKETS    = 0     # §17 anonymous-ticket peer search
# SWF_ENABLE_RECEIPTS   = 0     # §16 search-result receipts
# SWF_ENABLE_DCNET      = 0     # LAN_FRIEND_DCNET delivery path
# SWF_ENABLE_PEER_TRUST = 0     # gate pulls behind trust_level
# SWF_EXTRA_PEERS       =       # comma-separated url list, merged with peers.yaml

# ── Legacy env vars (still respected; prefer the SWF_-prefixed ones) ─
# RA_WORLD_KNOWLEDGE_DIR  → SWF_KNOWLEDGE_DIR
# RA_WORLD_KNOWLEDGE=0    → SWF_DISABLE_KNOWLEDGE_WRITE=1
# RA_CACHE_DIR            → swf.web.fetch on-disk cache (still RA_-prefixed)
# RA_CACHE_TTL_SEC        → fetch cache TTL (default 604800 = 7 days)
# RA_DISABLE_JINA=1       → never fall back to r.jina.ai for extraction
# RA_VERBOSE=1            → swf.fanout debug logging (independent of SWF_LOG_LEVEL)
